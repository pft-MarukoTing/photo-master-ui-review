STOP_PATH=./tmp/STOP.txt
READY_PATH=./tmp/ready.txt

REDIS_HB_KEY=

# Encrypt with aiserver_utils.aescipher.AESCipher.
OPENAI_API_KEY=

# hairfx's hair model, run in the server (unset: models/model_input_none_tf115.hdf5).
HAIR_SEG_MODEL=
# hairfx's face model and OpenCV steps: a python with torch, face_alignment and cv2.
HAIR_FACE_PYTHON=

# Render settings (unset: gpt-image-2.5-sunburst, medium, the photo's aspect).
AIHAIR_RENDER_MODEL=
AIHAIR_RENDER_QUALITY=
AIHAIR_RENDER_SIZE=match
# Billed OpenAI calls one task may have in flight; the client's timeout and retries.
AIHAIR_CALLS_PER_TASK=4
AIHAIR_OPENAI_TIMEOUT_S=300
AIHAIR_OPENAI_MAX_RETRIES=0
# Each task's timing (generate / postprocess / api / download / upload), one JSON line.
AIHAIR_TIMING_LOG=./log/aihair_timing.jsonl
