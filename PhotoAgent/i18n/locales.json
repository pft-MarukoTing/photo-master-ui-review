        "{v1}。": "{v1}.",
        "{v1}，{text}": "{v1}, {text}",
        "{v1}：": "{v1}: ",
        "{v1}：{v2}": "{v1}: {v2}",
        "{v1}：{v2}（{reason}）": "{v1}: {v2} ({reason})",
        "{what}：{ratio}": "{what}: {ratio}",
        "、": ", ",
        "。": ". ",
        "。@@句尾": ".",
        "「{v1}」": "\"{v1}\"",
        "（": " (",
        "（{level}）": " ({level})",
        "（{reason}）": " ({reason})",
        "）": ")",
        "，": ", ",
        "：": ": ",
        "；": "; "
      }
    }
  }
}
